{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banc-essai-2027:schema:metriques",
  "title": "Métriques d'un run",
  "description": "§8 : runs/<date>/metriques/metriques.json, écrit par pnpm analyze (analysis/analyse-du-run.ts, sous-lot A), jamais réécrit : absent, il est écrit ; identique à l'octet près, rien n'est fait ; différent, la commande refuse. Toutes les sections reposent sur un seul partage de la population (population), calculé une fois au calcul principal et repris tel quel par chaque recalcul de robustesse (§8 : « les seuils de non-publication ne sont pas réappliqués à la population restreinte »). Chaque section est calculée ou sans objet, avec son motif. Les kappas et le test contrefactuel n'y sont pas recopiés : ils vivent dans run.json, que entrees.run_json_sha256 désigne.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "entrees", "parametres", "population", "taux", "asymetrie", "conditions", "robustesse", "variabilite_echantillons", "comparateurs", "hypotheses", "exploratoire", "graines"],

  "properties": {
    "run_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/ulid" },
    "entrees": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_json_sha256", "tirage_sha256", "donnees_commit", "reponses_lues", "reponses_obtenues", "reponses_manquantes", "verdicts_lus", "notations_lues"],
      "description": "Ce que l'analyse a lu. run_json_sha256 est le SHA-256 de la forme canonique de run.json (clés triées, validation/domaine/empreinte.ts:canoniser) sans les champs que run.json reçoit après l'analyse (§9, protocole 0.28, D70 (13)) : statut, publication et depot, puis ceux que pnpm go-no-go écrit : go_no_go, motif_provisoire, indeterminees_echantillon_humain, non_classees_echantillon_humain, renvois_attribution_indecidable, refus_api_echantillon_humain, accord_humains_echantillon, juges[].kappa_echantillon_humain, juges[].motif_indefini_kappa_echantillon_humain, juges[].renvois_ecartes_kappa_echantillon et perimetre.outils[].par_mode.",
      "properties": {
        "run_json_sha256": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/sha256" },
        "tirage_sha256": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/sha256" },
        "donnees_commit": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/commit_git" },
        "reponses_lues": { "$ref": "#/$defs/effectif" },
        "reponses_obtenues": { "$ref": "#/$defs/effectif" },
        "reponses_manquantes": { "$ref": "#/$defs/effectif" },
        "verdicts_lus": { "$ref": "#/$defs/effectif" },
        "notations_lues": { "$ref": "#/$defs/effectif" }
      }
    },
    "parametres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reechantillonnages", "permutations"],
      "description": "§8 : 2 000 rééchantillonnages et 10 000 permutations. Les graines sont dans run.json (graines.bootstrap, graines.permutation) ; chaque graine dérivée est publiée dans graines.",
      "properties": {
        "reechantillonnages": { "type": "integer", "minimum": 1 },
        "permutations": { "type": "integer", "minimum": 1 }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime_inclusion", "couples_compares", "couples_incomplets", "candidats_compares", "candidats_rapportes_a_part", "strates", "modes_de_tete"],
      "description": "Le seul partage de la population : régime d'inclusion déclaré au gel (§3), couples outil × mode au seuil de 20 % compté sur le plan d'interrogation (§8), candidats au seuil de couverture lu au gel (§4), strates relevées sur les unités du calcul principal, mode de tête lu dans le périmètre.",
      "properties": {
        "regime_inclusion": {
          "enum": ["avant_liste_officielle", "liste_officielle", "entre_deux_tours"],
          "description": "§3 (0.27, D68) : perimetre.regime_inclusion de run.json, recopié. En entre_deux_tours, les règles qui dépendent du nombre de candidats se lisent avec deux candidats (§3, « Entre les deux tours »)."
        },
        "couples_compares": { "type": "array", "items": { "$ref": "#/$defs/couple" } },
        "couples_incomplets": { "type": "array", "items": { "$ref": "#/$defs/couple" }, "description": "§8 : « run incomplet », sans aucune statistique, exclus des comparaisons." },
        "candidats_compares": { "type": "array", "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" } },
        "candidats_rapportes_a_part": {
          "type": "array",
          "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" },
          "description": "§4 : sous le seuil de couverture, « rapporté à part, mention couverture insuffisante » ; aucune strate dans aucun calcul."
        },
        "strates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidats", "themes", "gabarits", "registres"],
          "properties": {
            "candidats": { "type": "array", "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" } },
            "themes": { "type": "array", "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/theme" } },
            "gabarits": { "type": "array", "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/gabarit" } },
            "registres": { "type": "array", "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/registre" } }
          }
        },
        "modes_de_tete": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outil_id", "mode"],
            "properties": {
              "outil_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" },
              "mode": { "$ref": "#/$defs/mode" }
            }
          }
        }
      }
    },
    "taux": {
      "description": "§8, métriques primaires et secondaires de chaque couple comparé, chacune avec son intervalle (analysis/incertitude.ts).",
      "oneOf": [
        { "$ref": "#/$defs/sans_objet" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["statut", "couples", "couples_incomplets"],
          "properties": {
            "statut": { "const": "calcule" },
            "couples": { "type": "array", "items": { "$ref": "#/$defs/taux_du_couple" } },
            "couples_incomplets": { "type": "array", "items": { "$ref": "#/$defs/couple" } }
          }
        }
      ]
    },
    "asymetrie": {
      "description": "§8, test d'asymétrie (QR3, H4) : un test de permutation par couple comparé, valeur p corrigée par Holm sur la famille des couples testés (analysis/permutation.ts).",
      "oneOf": [
        { "$ref": "#/$defs/sans_objet" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["statut", "couples", "couples_incomplets", "couples_sans_test"],
          "properties": {
            "statut": { "const": "calcule" },
            "couples": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["couple", "test"],
                "properties": {
                  "couple": { "$ref": "#/$defs/couple" },
                  "test": { "oneOf": [{ "$ref": "#/$defs/sans_objet" }, { "$ref": "#/$defs/test_asymetrie" }] }
                }
              }
            },
            "couples_incomplets": { "type": "array", "items": { "$ref": "#/$defs/cle_couple" } },
            "couples_sans_test": { "type": "array", "items": { "$ref": "#/$defs/cle_couple" } }
          }
        }
      ]
    },
    "conditions": {
      "description": "§8, effets de condition (QR6) : différences appariées entre modes et entre formulations, strates global et recents:60j (analysis/conditions.ts). Aucune valeur p.",
      "oneOf": [
        { "$ref": "#/$defs/sans_objet" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["statut", "strates"],
          "properties": {
            "statut": { "const": "calcule" },
            "strates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["strate", "modes", "formulations"],
                "properties": {
                  "strate": { "enum": ["global", "recents:60j"] },
                  "modes": { "$ref": "#/$defs/famille_de_conditions" },
                  "formulations": { "$ref": "#/$defs/famille_de_conditions" }
                }
              }
            }
          }
        }
      ]
    },
    "robustesse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taux", "differences"],
      "description": "§8, analyses de robustesse préenregistrées. taux : les métriques recalculées (a) à (d), sans qualificatif de fragilité, sur le partage et les strates du calcul principal (analysis/robustesse-taux.ts). differences : la fragilité des différences établies (analysis/robustesse.ts:fragiliteDesDifferences).",
      "properties": {
        "taux": {
          "oneOf": [
            { "$ref": "#/$defs/sans_objet" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["statut", "recalculs"],
              "properties": {
                "statut": { "const": "calcule" },
                "recalculs": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["recalcul", "couples", "couples_incomplets"],
                    "properties": {
                      "recalcul": { "enum": ["echantillon_humain", "items_contestes", "formulations_orientees", "reponses_tronquees"] },
                      "couples": { "type": "array", "items": { "$ref": "#/$defs/taux_du_couple" } },
                      "couples_incomplets": { "type": "array", "items": { "$ref": "#/$defs/couple" } }
                    }
                  }
                }
              }
            }
          ]
        },
        "differences": {
          "description": "§8 (0.27, D69 ; texte de la 0.30) : la fragilité de chaque différence établie au calcul principal des familles de résultats — modes et formulations de chaque strate des conditions, différence de H3, tendance —, recalculée (a) à (d) sur les unités restreintes, avec le partage, l'appariement et la clé du calcul principal (analysis/robustesse.ts:fragiliteDesDifferences). Une différence non établie au principal n'est pas un résultat et n'y figure pas ; les différences exploratoires (écart API / application, écart juge-éditeur, Spearman) non plus. tendance dit si la famille de la tendance a été lue (premier_run_absent sinon).",
          "oneOf": [
            { "$ref": "#/$defs/sans_objet" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["statut", "tendance", "resultats"],
              "properties": {
                "statut": { "const": "calcule" },
                "tendance": {
                  "oneOf": [
                    { "$ref": "#/$defs/sans_objet" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["statut", "premier_run_id"],
                      "properties": {
                        "statut": { "const": "calcule" },
                        "premier_run_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/ulid" }
                      }
                    }
                  ]
                },
                "resultats": { "type": "array", "items": { "$ref": "#/$defs/fragilite_d_une_difference" } }
              }
            }
          ]
        }
      }
    },
    "variabilite_echantillons": {
      "description": "§8, « Variabilité entre échantillons » (0.28, D70 (12)) : l'accord entre les deux échantillons d'une même question, dans une même formulation et un même mode, lu sur la catégorie primaire de leur note retenue, par couple comparé (analysis/accord-echantillons.ts). Un diagnostic, pas une métrique : ni intervalle, ni qualificatif, ni graine. Un couple « run incomplet » n'y figure pas (seuils de non-publication).",
      "oneOf": [
        { "$ref": "#/$defs/sans_objet" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["statut", "couples"],
          "properties": {
            "statut": { "const": "calcule" },
            "couples": { "type": "array", "items": { "$ref": "#/$defs/variabilite_du_couple" } }
          }
        }
      ]
    },
    "comparateurs": {
      "description": "§8, métriques secondaires (QR9) : pour chaque comparateur inclus, dans l'ordre du périmètre, couverture (items P affichés / items P de référence) et exactitude (items affichés compatibles / items affichés classés, une lecture indéterminée hors du dénominateur), chacune avec son intervalle, strate global, clé <outil> / lecture / <métrique> / global (§8, « Graines de l'analyse »). Les items P de référence sont ceux qui comptent pour le seuil de couverture de leur candidat interrogé (analysis/reference-comparateurs.ts) ; chaque comparateur en porte une lecture. Sans comparateur inclus au run : sans_objet, motif aucun_comparateur_inclus.",
      "oneOf": [
        { "$ref": "#/$defs/sans_objet" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["statut", "items_p_de_reference", "comparateurs"],
          "properties": {
            "statut": { "const": "calcule" },
            "items_p_de_reference": { "$ref": "#/$defs/effectif" },
            "comparateurs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/taux_du_comparateur" } }
          }
        }
      ]
    },
    "hypotheses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["H1", "H2", "H3", "H4", "H5"],
      "description": "§2 (0.27, D63) : H1 à H5 décidées par analysis/hypotheses.ts sur les sections ci-dessus. Une hypothèse non confirmée est non_confirmee, jamais « infirmée » (D67). H3 et H2 n'ont pas de verdict global ; H5 est sans objet (premier_run_absent) quand l'analyse ne reçoit pas de premier run (--premier).",
      "properties": {
        "H1": { "oneOf": [{ "$ref": "#/$defs/sans_objet" }, { "$ref": "#/$defs/h1" }] },
        "H2": { "oneOf": [{ "$ref": "#/$defs/sans_objet" }, { "$ref": "#/$defs/h2" }] },
        "H3": { "$ref": "#/$defs/h3" },
        "H4": { "oneOf": [{ "$ref": "#/$defs/sans_objet" }, { "$ref": "#/$defs/h4" }] },
        "H5": { "oneOf": [{ "$ref": "#/$defs/sans_objet" }, { "$ref": "#/$defs/h5" }] }
      }
    },
    "exploratoire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_couverture", "ecart_api_application"],
      "description": "Analyses exploratoires préannoncées (§2, §6, §8 : « tout autre chiffre porte l'étiquette « exploratoire » »). Chaque résultat porte exploratoire: true ; aucun qualificatif de fragilité (§8, robustesse : « Les différences exploratoires […] ne reçoivent aucun qualificatif de fragilité »).",
      "properties": {
        "correlation_couverture": {
          "description": "§2 : coefficient de Spearman entre le taux d'erreur d'un candidat et son nombre d'items P vérifiés, par couple comparé, sans intervalle (analysis/correlation-couverture.ts). §3 : en entre_deux_tours, sans objet (moins_de_trois_candidats).",
          "oneOf": [
            { "$ref": "#/$defs/sans_objet" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["statut", "couples", "couples_incomplets"],
              "properties": {
                "statut": { "const": "calcule" },
                "couples": { "type": "array", "items": { "$ref": "#/$defs/correlation_du_couple" } },
                "couples_incomplets": { "type": "array", "items": { "$ref": "#/$defs/couple" } }
              }
            }
          ]
        },
        "ecart_api_application": {
          "description": "§6, QR8 : exactitude de l'API (mode de tête, neutre, échantillon 1) moins celle de l'application, appariée par question sur le sous-échantillon, les saisies des deux testeurs dans la grappe de leur question ; clé bootstrap / exactitude / global / <outil>:api-application (analysis/ecart-api-application.ts). Sans objet (aucune_reponse_application) quand le run n'a aucune réponse de l'application.",
          "oneOf": [
            { "$ref": "#/$defs/sans_objet" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["statut", "par_outil", "outils_exclus", "outils_sans_reponse_application"],
              "properties": {
                "statut": { "const": "calcule" },
                "par_outil": { "type": "array", "items": { "$ref": "#/$defs/ecart_api_application" } },
                "outils_exclus": {
                  "type": "array",
                  "description": "§8 : le couple de tête de l'outil est « run incomplet » ; aucun chiffre.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["outil_id", "mode_de_tete", "motif"],
                    "properties": {
                      "outil_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" },
                      "mode_de_tete": { "$ref": "#/$defs/mode" },
                      "motif": { "const": "run_incomplet" }
                    }
                  }
                },
                "outils_sans_reponse_application": {
                  "type": "array",
                  "description": "Assistants inclus sans aucune réponse du canal application au run : nommés, sans chiffre.",
                  "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" }
                }
              }
            }
          ]
        }
      }
    },
    "graines": {
      "type": "array",
      "description": "§8, « Graines de l'analyse » : chaque clé publiée dans le document, une fois, triée, avec l'amorce de SplitMix64 en hexadécimal (analysis/graines.ts).",
      "items": { "$ref": "#/$defs/graine_nommee" }
    }
  },

  "$defs": {
    "effectif": { "type": "integer", "minimum": 0 },
    "modele_d_un_outil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outil_id", "modele_demande", "identifiants_renvoyes", "reponses_sans_identifiant"],
      "description": "§8 (0.31, D73 (17)) : réponses obtenues du canal api et du contexte run, tous modes ensemble ; une réponse manquante ne compte nulle part. Chaque identifiant est publié tel que l'API l'a renvoyé (règle 7), dans l'ordre des unités de code UTF-16.",
      "properties": {
        "outil_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" },
        "modele_demande": { "type": "string", "minLength": 1 },
        "identifiants_renvoyes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identifiant", "reponses"],
            "properties": {
              "identifiant": { "type": "string" },
              "reponses": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "reponses_sans_identifiant": { "$ref": "#/$defs/effectif" }
      }
    },
    "taux_du_comparateur": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outil_id", "couverture", "exactitude"],
      "description": "Un comparateur inclus : ses deux taux du §8, sur la strate global (toutes ses lectures, la grappe étant l'item lu).",
      "properties": {
        "outil_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" },
        "couverture": {
          "allOf": [{ "$ref": "#/$defs/taux_publie" }],
          "properties": { "metrique": { "const": "couverture" }, "strate": { "const": "global" } }
        },
        "exactitude": {
          "allOf": [{ "$ref": "#/$defs/taux_publie" }],
          "properties": { "metrique": { "const": "exactitude" }, "strate": { "const": "global" } }
        }
      }
    },
    "variabilite_du_couple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["couple", "paires_prevues", "paires_comparables", "paires_concordantes", "paires_ecartees"],
      "description": "Une paire = les deux échantillons prévus au plan pour une question et une formulation, dans ce couple. paires_prevues = paires_comparables + somme des paires_ecartees. accord = paires_concordantes / paires_comparables ; sans paire comparable, il est absent et motif_absence dit pourquoi (ni 0, ni null).",
      "properties": {
        "couple": { "$ref": "#/$defs/couple" },
        "paires_prevues": { "$ref": "#/$defs/effectif" },
        "paires_comparables": { "$ref": "#/$defs/effectif" },
        "paires_concordantes": { "$ref": "#/$defs/effectif" },
        "accord": { "type": "number", "minimum": 0, "maximum": 1 },
        "motif_absence": { "const": "aucune_paire_comparable" },
        "paires_ecartees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aucun_echantillon_obtenu", "un_seul_echantillon_obtenu", "non_classee", "indeterminee"],
          "description": "Un seul motif par paire, dans cet ordre : aucun échantillon obtenu, un seul obtenu, l'un au moins non classé (référence incomplète, sans catégorie primaire, §7, D64), l'un au moins indéterminé.",
          "properties": {
            "aucun_echantillon_obtenu": { "$ref": "#/$defs/effectif" },
            "un_seul_echantillon_obtenu": { "$ref": "#/$defs/effectif" },
            "non_classee": { "$ref": "#/$defs/effectif" },
            "indeterminee": { "$ref": "#/$defs/effectif" }
          }
        }
      },
      "oneOf": [
        { "required": ["accord"], "not": { "required": ["motif_absence"] }, "properties": { "paires_comparables": { "minimum": 1 } } },
        { "required": ["motif_absence"], "not": { "required": ["accord"] }, "properties": { "paires_comparables": { "const": 0 } } }
      ]
    },
    "correlation_du_couple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outil_id", "mode", "exploratoire", "points", "candidats_sans_exactitude", "coefficient", "motif_absence"],
      "description": "§2 : publiée sans intervalle. Les candidats sous le seuil de couverture n'y entrent pas ; un candidat comparé sans réponse classée est nommé dans candidats_sans_exactitude. Sous trois points, ou sur un classement constant, le coefficient est absent (null) avec son motif, jamais 0.",
      "properties": {
        "outil_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" },
        "mode": { "$ref": "#/$defs/mode" },
        "exploratoire": { "const": true },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidat_id", "taux_erreur", "items_p_verifies"],
            "properties": {
              "candidat_id": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" },
              "taux_erreur": { "$ref": "#/$defs/taux" },
              "items_p_verifies": { "$ref": "#/$defs/effectif" }
            }
          }
        },
        "candidats_sans_exactitude": { "type": "array", "items": { "$ref": "urn:banc-essai-2027:schema:commun#/$defs/identifiant_court" } },
