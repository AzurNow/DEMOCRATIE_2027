# Variables d'environnement lues par le dépôt. Copier en `.env` (ignoré par Git), remplir, puis
# charger dans le shell : `set -a; . ./.env; set +a`. Aucun code ne lit `.env` tout seul (pas de
# dotenv : une dépendance de moins). Aucune de ces variables n'est nécessaire pour
# `pnpm install && pnpm check && pnpm test`, ni pour `pnpm test:py`.

# --- Identité humaine (interfaces locales) -------------------------------------------------------

# Pseudonyme de l'annotateur, exigé par `pnpm validate` (et `pnpm dev`) et `pnpm notation:humaine`.
# Choisi par l'auteur (ex. a1, a2) ; jamais un nom réel (§10 du protocole, données personnelles).
ANNOTATEUR_ID=a1

# --- Interface de validation (validation/serveur) — toutes facultatives ---------------------------

# Port HTTP local de l'interface de validation. Défaut : 4173.
PORT=4173
# 1 = jeu de démonstration (validation/fixtures/*-demo), jamais publié. Absent = production.
BANC_DEMO=1
# Surcharges de chemins, pour les tests ou un jeu isolé. Absentes = emplacements par défaut.
# BANC_STAGING=staging
# BANC_DATA=data/items
# BANC_DATA_MESURES=data/mesures
# BANC_DATA_FORMULATIONS=data/formulations
# BANC_PERIMETRE=config/perimetre.yaml
# BANC_REFUS_FORMULATIONS=validation/formulations/refus.jsonl
# BANC_LOTS=validation/lots
# BANC_DECISIONS=validation/decisions
# BANC_BROUILLONS=validation/brouillons

# --- Clés d'API (appels réels, lancés par l'auteur seulement) -------------------------------------
# Les modes --simule et run:dry n'en ont pas besoin. Un agent ne lance jamais d'appel réel.
# Sans clé non plus : pnpm geler --simule, pnpm run:dry, pnpm notation:dry (runs/README.md, « De bout en bout en mode simulé »).

# Anthropic, double extraction (`pnpm extraire`) et juge réel (`pnpm notation:reelle`). Console : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REMPLACER
# Mistral, double extraction (`pnpm extraire`), reformulations (`pnpm reformuler`) et juge réel
# (`pnpm notation:reelle`).
# Console : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=REMPLACER

# --- Courriels de notification aux candidats (`pnpm notifier --envoyer`) ------------------------
# Adresse dédiée de contestation (D4, §10). Fournisseur SMTP pas encore nommé (docs/TACHES-AUTEUR.md).
BANC_SMTP_HOTE=smtp.exemple.org
BANC_SMTP_PORT=587
BANC_SMTP_UTILISATEUR=REMPLACER
BANC_SMTP_MOT_DE_PASSE=REMPLACER
BANC_SMTP_EXPEDITEUR=contestation@exemple.org
