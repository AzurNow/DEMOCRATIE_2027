node_modules/
validation/client/dist/
notation-humaine/client/dist/

# Brouillons de saisie : ni décisions, ni données publiables. Écrasables par nature,
# donc hors du journal append-only et hors du dépôt.
validation/brouillons/

# File d'arbitrage : instantané dérivé, réécrit à chaque `pnpm promote --ecrire` et recalculable à
# tout moment. Les décisions vivent dans le registre versionné validation/arbitrage/decisions.json.
validation/arbitrage/file.json

# Journal corrompu mis en quarantaine par la détection d'écriture interrompue.
*.incomplet

# Décisions et brouillons du jeu de démonstration : des essais, pas des validations.
validation/fixtures/decisions-demo/
validation/fixtures/brouillons-demo/

# Relecture des formulations en démonstration (BANC_DEMO=1) : formulations promues et refus d'essai,
# jamais des relectures publiables (décisions D39 et D42).
validation/fixtures/data-formulations-demo/
validation/fixtures/formulations-demo/

# Worktrees des sous-agents (Claude Code) : des copies de travail, jamais du contenu du dépôt.
.claude/worktrees/

# Copies locales des sources collectées (pipeline/collecte) : hors Git par décision du 2026-09-22.
# Git ne garde que les manifestes staging/sources/<sha256>.json (docs/CONTRATS.md §5).
archives/

# Poids du modèle de transcription (pipeline/collecte/transcription/poids.py) : 1,6 Go téléchargés
# au premier lancement à une révision épinglée, empreintes vérifiées avant chargement. Jamais dans Git.
modeles/

# Environnement Python géré par uv, et caches.
.venv/
__pycache__/
.pytest_cache/

# Textes canoniques et transcriptions intégrales des sources : hors Git par décision du 2026-09-25
# (constat de conformité n° 31). Le §10 ne publie une copie intégrale que si sa licence le permet,
# et d'un enregistrement T2 que la transcription de l'extrait. On publie l'empreinte, l'archive de
# référence et la citation ; un tiers réextrait le texte de l'archive avec le code publié. Les
# fiches .json de ces répertoires (traçabilité de la production, §9) restent versionnées.
/staging/textes/*.txt
/staging/transcriptions/*.vtt

# Volume d'un run (runs/README.md) : réponses brutes, journaux des tentatives, notations individuelles.
# Hors Git par décision (CLAUDE.md, « Ce que Git stocke ») : il part dans l'archive Zenodo, référencée
# depuis runs/<date>/run.json par son DOI et son empreinte SHA-256.
/runs/*/volume/

# Copies locales des preuves du périmètre (pnpm preuve) : octets téléchargés, jamais versionnés ;
# la preuve publiée est le bloc url + sha256 + archive_url de config/perimetre.yaml.
/scratch/perimetre/preuves/

# Secrets : jamais dans Git. Seul .env.example (des valeurs factices) est versionné.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Pages tierces capturées pendant les relevés du périmètre (scratch/) : octets d'autrui, même
# règle que archives/ et /scratch/perimetre/preuves/. Les notes et index de relevé restent suivis.
/scratch/perimetre/releves-*/*.html
/scratch/perimetre/releves-*/*.gz

# Verrou d’un registre à ajout seul (validation/io/registre-ajout-seul.ts) : orphelin après un arrêt brutal, à supprimer à la main.
*.verrou
