{
  "$comment": "Configuration serveur, outils et tests. Les clients ont la leur : validation/client/tsconfig.json et notation-humaine/client/tsconfig.json.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["analysis", "pipeline", "validation/domaine", "validation/io", "validation/serveur", "validation/fixtures", "notation-humaine/serveur", "outils", "tests", "eslint.config.d.ts"],
  "exclude": ["node_modules", "validation/client", "notation-humaine/client"]
}
