{
  "name": "banc-essai-2027",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "BANC_DEMO=1 pnpm run validate",
    "build": "pnpm run build:client && pnpm run build:client:notation",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p validation/client/tsconfig.json && tsc --noEmit -p notation-humaine/client/tsconfig.json && eslint . && node --experimental-strip-types outils/schemas.ts",
    "check:client": "tsc --noEmit -p validation/client/tsconfig.json",
    "lint": "eslint .",
    "schemas": "node --experimental-strip-types outils/schemas.ts",
    "test": "vitest run",
    "build:client": "tsc -p validation/client/tsconfig.json",
    "build:client:notation": "tsc -p notation-humaine/client/tsconfig.json",
    "notation:humaine": "pnpm run build:client:notation && node --experimental-strip-types outils/notation-humaine.ts",
    "validate": "pnpm run build:client && node --experimental-strip-types validation/serveur/principal.ts",
    "symmetry": "node --experimental-strip-types outils/symmetry.ts",
    "run:dry": "node --experimental-strip-types outils/run-dry.ts",
    "interrogation:attente": "node --experimental-strip-types outils/attente-operateur.ts",
    "interrogation:stocker": "node --experimental-strip-types outils/interrogation-stocker.ts",
    "run:invalider": "node --experimental-strip-types outils/run-invalider.ts",
    "reformuler": "node --experimental-strip-types outils/reformuler.ts",
    "extraire": "node --experimental-strip-types outils/extraire.ts",
    "geler": "node --experimental-strip-types outils/geler.ts",
    "feuille-de-route": "node --experimental-strip-types outils/feuille-de-route.ts",
    "appels-interrogation": "node --experimental-strip-types outils/appels-interrogation.ts",
    "lots": "node --experimental-strip-types outils/lots.ts",
    "mesures": "node --experimental-strip-types outils/mesures.ts",
    "promote": "node --experimental-strip-types outils/promote.ts",
    "arbitrer": "node --experimental-strip-types outils/arbitrer.ts",
    "contester": "node --experimental-strip-types outils/contester.ts",
    "panel": "node --experimental-strip-types outils/panel.ts",
    "diagnostics": "node --experimental-strip-types outils/diagnostics.ts",
    "notation:controle": "node --experimental-strip-types outils/notation-controle.ts",
    "notation:dry": "node --experimental-strip-types outils/notation-dry.ts",
    "analyze": "node --experimental-strip-types outils/analyze.ts",
    "recalcul-b": "node --experimental-strip-types outils/recalcul-b.ts",
    "contestations-posterieures": "node --experimental-strip-types outils/contestations-posterieures.ts",
    "go-no-go": "node --experimental-strip-types outils/go-no-go.ts",
    "go-no-go:contresigner": "node --experimental-strip-types outils/go-no-go-contresigner.ts",
    "proprete": "node --experimental-strip-types outils/proprete.ts",
    "fixtures": "node --experimental-strip-types validation/fixtures/engendrer.ts",
    "collecte": "uv run python -m pipeline.collecte",
    "liens": "uv run python -m pipeline.liens",
    "liens:textes": "uv run python -m pipeline.liens.textes",
    "preuve": "uv run python -m pipeline.preuve",
    "textes": "uv run python -m pipeline.collecte.textes",
    "transcriptions": "uv run python -m pipeline.collecte.transcription",
    "extraction:entrees": "uv run python -m pipeline.collecte.entrees_extraction",
    "notifier": "node --experimental-strip-types outils/contacts.ts | uv run python -m pipeline.notification",
    "check:py": "uv run ruff check pipeline tests",
    "test:py": "uv run pytest"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "10.10.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^2.1.8"
  }
}
